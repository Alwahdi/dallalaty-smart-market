{
  "name": "matjer-ibb-expo",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run tests",
    "doctor": "expo-doctor",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android": "eas build --platform android --profile production",
    "build:ios": "eas build --platform ios --profile production"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-web": "~0.21.4",
    "expo-router": "~58.0.25",
    "expo-secure-store": "~58.0.2",
    "expo-image": "~58.0.16",
    "expo-video": "~58.0.12",
    "expo-image-picker": "~58.0.10",
    "expo-image-manipulator": "~58.0.15",
    "expo-location": "~58.0.18",
    "expo-linking": "~58.0.14",
    "expo-web-browser": "~58.0.6",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-status-bar": "~58.0.4",
    "expo-splash-screen": "~58.0.11",
    "expo-notifications": "~58.1.6",
    "expo-device": "~58.0.5",
    "expo-constants": "~58.0.13",
    "expo-localization": "~58.0.5",
    "expo-dev-client": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "0.13.0",
    "@expo/vector-icons": "^15.0.2",
    "@sentry/react-native": "~8.28.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@expo/metro-runtime": "~58.0.15",
    "expo": "~58.0.17",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "^5.56.2",
    "react-native-paper": "^5.14.5",
    "react-native-url-polyfill": "^2.0.0",
    "@expo-google-fonts/cairo": "^0.4.2"
